# Open Pharma Plugins — Configuration
# Copy this file to ~/.open-pharma-plugins/config and fill in the values you need.
# Environment variables override values in this file.
# Keep comments on separate lines. Inline comments are parsed as part of the value.

# ── Web Search (used by hcp-intelligence and competitive-intelligence) ──
# At least one search API key is required for web-based tools.
# Values: auto | serper | tavily | exa
# OPEN_PHARMA_SEARCH_BACKEND=auto
# SERPER_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=

# ── HCP Intelligence ──
# Required only when scripts/batch_enrich.py uses --synthesize.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional; raises the PubMed rate limit from 3 to 10 requests/second.
# NCBI_API_KEY=
# Default: ~/.open-pharma-plugins/hcp-intelligence
# OPEN_PHARMA_HCP_DATA_DIR=

# ── Field Training ──
# Default: ~/.open-pharma-plugins/training-content
# OPEN_PHARMA_TRAINING_CONTENT_DIR=

# ── Campaign Studio ──
# Default: ~/.open-pharma-plugins/campaign-studio
# OPEN_PHARMA_CAMPAIGN_STORE_DIR=

# ── Next Best Engagement ──
# Default: ~/.open-pharma-plugins/next-best-engagement
# OPEN_PHARMA_NBE_OUTPUT_DIR=

# ── Territory Alignment ──
# Default: built-in fixtures
# OPEN_PHARMA_TA_DATA_DIR=
# Default: ~/.open-pharma-plugins/territory-alignment/scenarios
# OPEN_PHARMA_TA_SCENARIOS_DIR=

# ── Competitive Intelligence ──
# Default: ~/.open-pharma-plugins/competitive-intelligence
# OPEN_PHARMA_CI_DATA_DIR=
# Optional. Both modes allow 240 requests/minute. Daily quota is 1,000/IP without a key or
# 120,000/key with one.
# OPENFDA_API_KEY=
# Hours before cached API responses expire.
# CI_CACHE_TTL_HOURS=24
